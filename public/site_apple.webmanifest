{
    "name": "zWeb",
    "short_name": "zWeb",
    "description": "zWeb — быстрый веб-мессенджер с плагинами, своим оформлением и памятью чатов.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "theme_color": "#0b0613",
    "background_color": "#0b0613",
    "lang": "ru",
    "icons": [
        {
            "src": "assets/img/icon_square_192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/img/icon_square_384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "assets/img/icon_square_512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": "*/*"
                }
            ]
        }
    }
}